{
  "manifest_version": 3,
  "name": "Prompt Enhancer & RTL Fix",
  "version": "3.1",
  "description": "Enhances prompts using OpenRouter AI and fixes RTL/LTR text direction on AI platforms",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://openrouter.ai/*", "https://api.groq.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*", "https://chatgpt.com/*", "https://www.chatgpt.com/*",
        "https://aistudio.google.com/*", "https://notebooklm.google.com/*",
        "https://chat.qwen.ai/*", "https://console.groq.com/*", "https://bard.google.com/*",
        "https://gemini.google.com/*", "https://claude.ai/*", "https://www.claude.ai/*",
        "https://perplexity.ai/*", "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*", "https://chat.mistral.ai/*", "https://huggingface.co/chat/*",
        "https://grok.com/*", "https://coral.cohere.com/*", "https://chat.z.ai/*",
        "https://poe.com/*", "https://character.ai/*", "https://duck.ai/*",
        "https://you.com/*", "https://phind.com/*", "https://pi.ai/*", "https://www.meta.ai/*",
        "https://chat.openrouter.ai/*", "https://openrouter.ai/chat/*"
      ],
      "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "commands": {
    "enhance-prompt": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Enhance current prompt"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}